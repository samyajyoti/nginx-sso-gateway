SSO_SECRET_KEY=replace-with-a-random-secret
SSO_ALLOWED_EMAIL_DOMAINS=datacultr.com
SSO_COOKIE_DOMAIN=.wrtual.in
SSO_AUTH_HOST=test-sso.wrtual.in
SSO_DEFAULT_REDIRECT_URL=https://test-sso.wrtual.in/
SSO_COOKIE_NAME=wrtual_sso
SSO_COOKIE_SECURE=true
SSO_COOKIE_SAMESITE=lax
SSO_SESSION_MAX_AGE=28800

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://test-sso.wrtual.in/auth/google/callback
GOOGLE_HOSTED_DOMAIN=datacultr.com

# Optional per-app access policy.
# Format: host=user1,user2; host2=user3
# Hostnames not listed here are open to any signed-in allowed-domain user.
# Use "*" as the user list to explicitly allow everyone for a given host.
SSO_APP_ACCESS=app1.wrtual.in=user1@datacultr.com; app2.wrtual.in=user1@datacultr.com,user2@datacultr.com
